# ═══════════════════════════════════════════════════════════════
# PRIMELEAD AI — Production Environment Variables
# Copy to server/.env and fill in real values before deploying
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Database (PostgreSQL required for production) ───────────
DATABASE_URL="postgresql://primelead:STRONG_PASSWORD_HERE@db:5432/primelead"

# ── Auth ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_96_CHAR_HEX_STRING
SESSION_COOKIE_NAME=pl_session
SESSION_MAX_AGE_DAYS=7
COOKIE_SECURE=true

# ── CORS ────────────────────────────────────────────────────
CLIENT_ORIGIN=https://yourdomain.com

# ── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="PRIMELEAD AI <noreply@yourdomain.com>"
APP_URL=https://yourdomain.com

# ── AI (OpenAI-compatible) ──────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=sk-your-openai-key
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# ── Payments (pick ONE provider) ────────────────────────────
# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# Shared webhook secret for demo/simulated payments
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_STRONG_SECRET

# ── WhatsApp ────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Storage (S3-compatible) ─────────────────────────────────
STORAGE_PROVIDER=local
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ── Admin ───────────────────────────────────────────────────
SUPER_ADMIN_EMAILS=admin@yourdomain.com

# ── Redis (optional, for caching) ───────────────────────────
REDIS_URL=redis://redis:6379

# ── Rate Limiting ───────────────────────────────────────────
API_RATE_LIMIT=100
LOGIN_RATE_LIMIT=10

# ── GSP / GST (India) ──────────────────────────────────────
NIC_USER_ID=
NIC_PASSWORD=
NIC_GSTIN=
CLEARTAX_AUTH_TOKEN=

# ── Twilio (SMS) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Server Host ─────────────────────────────────────────────
HOST=0.0.0.0
