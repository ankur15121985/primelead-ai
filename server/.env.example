# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (SQLite for local dev — Postgres is a drop-in:
#    replace with postgresql://user:pass@localhost:5432/primelead) ──
DATABASE_URL="file:./dev.db"

# ── Auth ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Used for the short-lived MFA challenge token. Sessions are DB-backed (opaque
# random token in the httpOnly cookie, SHA-256 hash stored server-side).
JWT_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=pl_session
SESSION_MAX_AGE_DAYS=7
# Account lock-out: after LOGIN_MAX_ATTEMPTS failed logins the account locks
# for LOGIN_LOCK_MINUTES minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# MFA / TOTP (otplib)
MFA_ISSUER="PRIMELEAD AI"
MFA_TOKEN_TTL_MINUTES=10
# In production set to true (requires HTTPS)
COOKIE_SECURE=false

# ── CORS (comma separated origins allowed in production) ──
CLIENT_ORIGIN=http://localhost:5173

# ── Super admin (website handler / developer)
#    Comma-separated emails allowed to open the /admin dashboard.
#    Leave empty to disable the admin area entirely (safe default).
SUPER_ADMIN_EMAILS=owner@primelead.demo

# ── Email (SMTP). When unset, emails are printed to the server console (dev mode). ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PRIMELEAD AI <no-reply@primelead.local>"
APP_URL=http://localhost:5173

# ── AI (provider abstraction — OpenAI-compatible endpoint)
#    Set AI_PROVIDER=openai / anthropic / gemini / custom
#    For "custom" provide AI_BASE_URL pointing at any OpenAI-compatible API.
#    The app runs fine without these — AI features show a friendly "connect your AI key" state.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# ── Storage (S3-compatible — optional, used for exports later) ──
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
