# ──────────────────────────────────────────────────────────────────
# PRIMELEAD AI — PostgreSQL Configuration
# ──────────────────────────────────────────────────────────────────
# Copy this to server/.env and update DATABASE_URL
#
# Usage:
#   1. Create database: createdb primelead
#   2. Copy this file: cp .env.postgres.example .env
#   3. Update DATABASE_URL below
#   4. Run migration: bash scripts/migrate-to-postgres.sh
#   5. Seed data: npm run db:seed
# ──────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (PostgreSQL) ───────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/primelead"
# Production (e.g., Railway, Supabase, Neon):
# DATABASE_URL="postgresql://user:pass@db.example.com:5432/primelead?pgbouncer=true"

# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=pl_session
SESSION_MAX_AGE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MFA_ISSUER="PRIMELEAD AI"
MFA_TOKEN_TTL_MINUTES=10
COOKIE_SECURE=false

# ── CORS ────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Super admin ─────────────────────────────────────────────────
SUPER_ADMIN_EMAILS=owner@primelead.demo

# ── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PRIMELEAD AI <no-reply@primelead.local>"
APP_URL=http://localhost:5173

# ── AI ──────────────────────────────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# ── Billing / Payments ─────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
PAYMENT_SUCCESS_URL=http://localhost:5173/app/billing?status=success
PAYMENT_CANCEL_URL=http://localhost:5173/app/billing?status=cancelled
TRIAL_DAYS=14

# ── Storage (S3) ────────────────────────────────────────────────
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
