  // Template data: nodes, connections, trigger config, action configs
  templateData    Json
  isSystem        Boolean      @default(false)
  useCount        Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, name])
  @@index([orgId, category])
}

// ────────────────────────────────────────────────────────────
