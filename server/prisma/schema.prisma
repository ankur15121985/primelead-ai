  openedAt        DateTime?
  clickedAt       DateTime?
  bouncedAt       DateTime?

  @@index([orgId, enrollmentId])
  @@index([orgId, status])
  @@index([orgId, sentAt])
}

// ────────────────────────────────────────────────────────────
