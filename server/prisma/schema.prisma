// ────────────────────────────────────────────────────────────
// Phase 13: Data Protection & Compliance
// ────────────────────────────────────────────────────────────

model ConsentRecord {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Contact-level consent
  contactId       String?
  companyId       String?
  // Consent details
  type            String       // MARKETING_EMAIL | MARKETING_SMS | MARKETING_CALL | DATA_PROCESSING | DATA_SHARING | COOKIES | THIRD_PARTY
  status          String       // GRANTED | DENIED | WITHDRAWN | EXPIRED | PENDING
  // Source & evidence
  source          String?      // FORM | EMAIL_REPLY | WEBSITE | API | PHONE | MANUAL | IMPORT
  sourceRef       String?      // reference to form/submission/etc
  evidence        String?      // free-text or JSON evidence
  // IP & location at consent time
  ipAddress       String?
  userAgent       String?
  geoLocation     String?
  // Lifecycle
  grantedAt       DateTime?
  withdrawnAt     DateTime?
  expiresAt       DateTime?
  // Compliance
  lawfulBasis     String?      // CONSENT | LEGITIMATE_INTEREST | CONTRACT | LEGAL_OBLIGATION
  version         String?      // policy version when consent was given
  // Verification
  verifiedAt      DateTime?
  verifiedBy      String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orgId, type])
  @@index([orgId, contactId])
  @@index([orgId, status])
  @@index([orgId, createdAt])
}

model SuppressionEntry {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // What is suppressed
  type            String       // EMAIL | EMAIL_DOMAIN | PHONE | IP | CONTACT | DOMAIN
  value           String       // the suppressed value (email, domain, phone, etc.)
  contactId       String?
  companyId       String?
  // Reason
  reason          String       // UNSUBSCRIBE | BOUNCE | SPAM_COMPLAINT | MANUAL | REGULATION | DOMAIN_BLOCK
  reasonDetail    String?
  // Source
  source          String?      // AUTOMATIC | MANUAL | API | WEBHOOK
  sourceRef       String?      // reference to bounce/complaint event
  // Scope
  isGlobal        Boolean      @default(false) // suppress across all sequences
  // Lifecycle
  suppressedAt    DateTime     @default(now())
  expiresAt       DateTime?    // temporary suppression
  removedAt       DateTime?
  removedBy       String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, type, value])
  @@index([orgId, type])
  @@index([orgId, contactId])
  @@index([orgId, value])
  @@index([orgId, createdAt])
}

model RetentionPolicy {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  // What entity this applies to
  entityType      String       // CONTACT | COMPANY | LEAD | CONVERSATION | CALL_RECORDING | FORM_SUBMISSION | ACTIVITY | AUDIT_LOG | ALL
  // Retention settings
  retentionDays   Int          // days to keep records
  autoDelete      Boolean      @default(false) // auto-delete or flag for review
  // Actions
  actionBeforeDelete String?    // ANONYMIZE | ARCHIVE | EXPORT | NOTIFY | NONE
  notifyBeforeDelete Boolean   @default(false)
  notifyEmail     String?
  notifyDaysBefore Int?
  // Status
  isActive        Boolean      @default(true)
  lastRunAt       DateTime?
  recordsDeleted  Int          @default(0)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, name])
  @@index([orgId, entityType])
  @@index([orgId, isActive])
}

model ExportJob {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [id], references: [id], onDelete: Cascade)
  userId          String
  // What is being exported
  entityType      String       // CONTACT | COMPANY | LEAD | ACTIVITY | REPORT
  format          String       @default("CSV") // CSV | EXCEL | JSON | PDF
  // Filters applied
  filters         Json?
  // Status
  status          String       @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  // Results
  recordCount     Int          @default(0)
  fileUrl         String?
  fileSize        Int?
  // Security
  ipAddress       String?
  downloadCount   Int          @default(0)
  expiresAt       DateTime?
  error           String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orgId, userId])
  @@index([orgId, status])
  @@index([orgId, entityType])
  @@index([orgId, createdAt])
}

model DataAccessRequest {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [id], references: [id], onDelete: Cascade)
  // Requester
  userId          String?
  contactEmail    String?      // for external data subjects
  contactId       String?
  // Request type
  type            String       // ACCESS | DELETION | RECTIFICATION | PORTABILITY | RESTRICTION | OBJECTION
  // Status
  status          String       @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | DENIED | EXPIRED
  // Details
  description     String?
  responseNotes   String?
  // Actions taken
  dataProvided    Boolean      @default(false)
  dataDeleted     Boolean      @default(false)
  dataAnonymized  Boolean      @default(false)
  // Compliance
  deadlineAt      DateTime?    // GDPR: 30 days
  completedAt     DateTime?
  completedBy     String?
  ipAddress       String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orgId, status])
  @@index([orgId, type])
  @@index([orgId, userId])
  @@index([orgId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 14: API Keys & Webhook Platform
// ────────────────────────────────────────────────────────────

model ApiKey {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Key details
  name            String
  keyPrefix       String       // first 8 chars for identification (e.g. "pk_live_a")
  keyHash         String       // bcrypt/scrypt hash of the full key
  // Scoping
  scopes          Json         // ["contacts.read", "companies.read", "leads.write"]
  rateLimit       Int?         // per-minute limit override
  // Status
  isActive        Boolean      @default(true)
  // Usage tracking
  lastUsedAt      DateTime?
  lastUsedIp      String?
  totalRequests   Int          @default(0)
  // Lifecycle
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedReason   String?
  createdBy       String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@index([keyPrefix])
  @@index([orgId, createdAt])
}

model WebhookEndpoint {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Endpoint details
  name            String
  url             String
  // Secret for HMAC signature validation
  secret          String?
  // Events to subscribe to
  events          Json         // ["lead.created", "lead.updated", "deal.won", "contact.enriched"]
  // Security
  ipWhitelist     Json?        // ["1.2.3.4", "5.6.7.0/24"]
  signatureHeader String?      @default("x-webhook-signature")
  // Retry config
  retryPolicy     String?      // LINEAR | EXPONENTIAL | NONE
  maxRetries      Int          @default(3)
  timeoutMs       Int          @default(5000)
  // Status
  isActive        Boolean      @default(true)
  status          String       @default("ACTIVE") // ACTIVE | PAUSED | ERROR | DISABLED
  // Stats
  totalDeliveries Int          @default(0)
  successCount    Int          @default(0)
  failureCount    Int          @default(0)
  lastTriggeredAt DateTime?
  lastStatus      String?      // SUCCESS | FAILED | TIMEOUT
  lastError       String?
  deliveries      WebhookDelivery[]
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@index([orgId, createdAt])
}

model WebhookDelivery {
  id              String       @id @default(cuid())
  orgId           String
  endpointId      String
  endpoint        WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  // Event details
  event           String       // "lead.created", "deal.won", etc.
  payload         Json
  // Delivery
  status          String       @default("PENDING") // PENDING | DELIVERING | SUCCESS | FAILED | RETRYING
  httpStatus      Int?
  responseBody    String?
  responseHeaders Json?
  // Retry
  attempt         Int          @default(1)
  maxAttempts     Int          @default(3)
  nextRetryAt     DateTime?
  // Security
  signature       String?      // HMAC signature sent
  ipAddress       String?
  // Timing
  durationMs      Int?
  error           String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orgId, endpointId])
  @@index([orgId, event])
  @@index([orgId, status])
  @@index([orgId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 16: Custom Report Builder
// ────────────────────────────────────────────────────────────

model SavedReport {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  // Report config
  entityType      String       // CONTACT | COMPANY | DEAL | LEAD | SEQUENCE | CALL | MEETING
  metrics         Json         // [{field, fn: COUNT|SUM|AVG|MIN|MAX}]
  dimensions      Json         // [{field, groupBy}] — x-axis / groupings
  filters         Json?        // saved filter state
  // Display
  chartType       String       @default("TABLE") // TABLE | BAR | LINE | PIE | FUNNEL | AREA
  dateRange       String?      // 7d | 30d | 90d | custom
  dateField       String?      // createdAt | updatedAt | closedAt
  // Sharing
  isPublic        Boolean      @default(false)
  sharedWithUserIds String  @default("[]") // JSON array of user IDs
  sharedWithTeamIds String  @default("[]") // JSON array of team IDs
  // Scheduling
  scheduledCron   String?      // cron expression for auto-refresh
  lastGeneratedAt DateTime?
  // Stats
  viewCount       Int          @default(0)
  lastViewedAt    DateTime?
  // Ownership
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, name])
  @@index([orgId, entityType])
  @@index([orgId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 17: Territory Management & Account Ownership
// ────────────────────────────────────────────────────────────

model Territory {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Territory criteria (JSON-serialized rules)
  countries   String       @default("[]") // JSON array
  states      String       @default("[]") // JSON array
  cities      String       @default("[]") // JSON array
  zipCodes    String       @default("[]") // JSON array
  industries  String       @default("[]") // JSON array
  employeeRanges String   @default("[]") // JSON array
  // Ownership
  ownerId     String?
  owner       User?        @relation("TerritoryOwner", fields: [ownerId], references: [id])
  teamId      String?
  isActive    Boolean      @default(true)
  accounts    AccountOwnership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orgId, name])
  @@index([orgId, isActive])
}

model AccountOwnership {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Which entity this ownership applies to
  entityType      String       // COMPANY | LEAD | CONTACT
  entityId        String
  // Ownership details
  ownerId         String
  owner           User?        @relation("AccountOwner", fields: [ownerId], references: [id])
  coOwnerId       String?
  coOwner         User?        @relation("AccountCoOwner", fields: [coOwnerId], references: [id])
  territoryId     String?
  territory       Territory?   @relation(fields: [territoryId], references: [id])
  // History tracking
  acquiredAt      DateTime     @default(now())
  lostAt          DateTime?
  lostReason      String?
  isActive        Boolean      @default(true)
  changedBy       String?
  changeReason    String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, entityType, entityId, isActive])
  @@index([orgId, ownerId])
  @@index([orgId, entityType])
  @@index([orgId, territoryId])
  @@index([orgId, isActive])
}

// ────────────────────────────────────────────────────────────
// Phase 18: Sales Coaching & Forecasting
// ────────────────────────────────────────────────────────────

model CoachingInsight {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId          String       // Rep being coached
  user            User?        @relation(fields: [userId], references: [id])
  period          String       // "2024-01" | "2024-W03" | "2024-Q1"
  periodType      String       @default("MONTH") // WEEK | MONTH | QUARTER
  // Metrics
  activityScore   Int          @default(0) // 0-100
  callMetrics     Json?        // {made, connected, avgDuration, bookings}
  emailMetrics    Json?        // {sent, opened, replied, positiveReplies}
  meetingMetrics  Json?        // {held, noShows, conversionRate}
  pipelineMetrics Json?        // {created, value, won, winRate}
  // AI coaching
  strengths       String       @default("[]") // JSON array
  improvements    String       @default("[]") // JSON array
  recommendations String       @default("[]") // JSON array
  summary         String?
  // Metadata
  generatedBy     String       @default("SYSTEM") // SYSTEM | MANAGER | AI
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, userId, period])
  @@index([orgId, period])
  @@index([orgId, userId])
}

model ForecastEntry {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Forecast scope
  period          String       // "2024-01" | "2024-Q1" | "2024"
  periodType      String       @default("MONTH") // WEEK | MONTH | QUARTER | YEAR
  userId          String?      // null = org-wide forecast
  user            User?        @relation("ForecastUser", fields: [userId], references: [id])
  territoryId     String?
  // Pipeline data (auto-calculated or manual override)
  pipelineValue   Int          @default(0) // total pipeline in period
  commitValue     Int          @default(0) // committed deals
  bestCaseValue   Int          @default(0) // best case
  closedWon       Int          @default(0) // already closed won
  closedLost      Int          @default(0) // already closed lost
  // Manual overrides
  manualCommit    Int?
  manualBestCase  Int?
  manualPipeline  Int?
  // Forecast metadata
  confidence      Float        @default(0) // 0-100 avg confidence
  dealCount       Int          @default(0)
  weightedPipeline Int         @default(0)
  // AI predictions
  aiPrediction    Int?         // AI-predicted revenue
  aiConfidence    Float?
  aiFactors       String       @default("[]") // JSON array of contributing factors
  // Metadata
  isLocked        Boolean      @default(false)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, period, userId])
  @@index([orgId, period])
  @@index([orgId, userId])
}

// ────────────────────────────────────────────────────────────
// Scheduled Messaging Queue
// ────────────────────────────────────────────────────────────

model ScheduledMessage {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId          String?
  // WHATSAPP | EMAIL | SMS (future)
  channel         String       @default("WHATSAPP")
  // DIRECT | SEQUENCE | BROADCAST
  type            String       @default("DIRECT")
  // Target
  recipientPhone  String?
  recipientEmail  String?
  recipientName   String?
  leadId          String?
  contactId       String?
  conversationId  String?
  // Content
  subject         String?      // email only
  body            String?
  templateName    String?      // WhatsApp template name
  templateParams  Json?        // string[] — template parameter values
  templateLanguage String?     // e.g. "en"
  // Scheduling
  status          String       @default("PENDING") // PENDING | PROCESSING | SENT | DELIVERED | READ | FAILED | CANCELLED
  scheduledAt     DateTime     // when to send
  startedAt       DateTime?
  sentAt          DateTime?
  failedAt        DateTime?
  // Retry
  retryCount      Int          @default(0)
  maxRetries      Int          @default(3)
  lastError       String?
  nextRetryAt     DateTime?
  // Priority (lower = higher priority)
  priority        Int          @default(100)
  // Batch group
  batchId         String?
  // Cost tracking
  providerCostPaise Int        @default(0)
  providerMessageId String?
  // Metadata
  source          String?      // SEQUENCE | BROADCAST | API | MANUAL | AUTOMATION
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  logs            ScheduledMessageLog[]

  @@index([orgId, status])
  @@index([orgId, scheduledAt])
  @@index([orgId, channel])
  @@index([orgId, status, scheduledAt])
  @@index([orgId, batchId])
  @@index([status, scheduledAt, priority])
}

model ScheduledMessageLog {
  id              String       @id @default(cuid())
  orgId           String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messageId       String
  message         ScheduledMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // QUEUED | PROCESSING | SENT | DELIVERED | READ | FAILED | RETRYING | CANCELLED
  status          String
  // Provider details
  providerMessageId String?
  provider        String?
  httpStatus      Int?
  responseBody    String?
  error           String?
  durationMs      Int?
  metadata        Json?
  createdAt       DateTime     @default(now())

  @@index([orgId, messageId])
  @@index([orgId, status])
  @@index([orgId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 20: Email Templates
// ────────────────────────────────────────────────────────────

model EmailTemplate {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   String
  name        String
  description String?
  category    String       @default("OTHER") // MARKETING | TRANSACTIONAL | FOLLOW_UP | SEQUENCE | NEWSLETTER | OTHER
  subject     String
  htmlContent String
  textContent String?
  variables   Json?        // [{ name, label, type, required, defaultValue }]
  fromName    String?
  fromEmail   String?
  replyTo     String?
  tags        Json?        // string[]
  usageCount  Int          @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId, category])
  @@index([orgId, name])
}

// ────────────────────────────────────────────────────────────
// Phase 20: Scheduled Reports
// ────────────────────────────────────────────────────────────

model ScheduledReport {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    String
  name         String
  description  String?
  reportConfig Json         // { entity, metrics, dimensions, filters, dateFrom, dateTo }
  schedule     Json         // { frequency, dayOfWeek, dayOfMonth, hour, timezone }
  recipients   Json?        // string[]
  webhookUrl   String?
  format       String       @default("CSV") // CSV | JSON
  enabled      Boolean      @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  logs         ScheduledReportLog[]

  @@index([orgId, enabled])
  @@index([orgId, nextRunAt])
}

model ScheduledReportLog {
  id         String          @id @default(cuid())
  orgId      String
  reportId   String
  report     ScheduledReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status     String          @default("SUCCESS") // SUCCESS | FAILED
  format     String?
  rowCount   Int?
  filename   String?
  error      String?
  createdAt  DateTime        @default(now())

  @@index([orgId, reportId])
  @@index([orgId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 24: SMS Lead Generation + Call Recording + AI Meeting Notes
// ────────────────────────────────────────────────────────────

/** Inbound SMS messages that generate leads */
model SmsInbound {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id])
  contactId       String?
  fromNumber      String
  toNumber        String?
  body            String
  receivedAt      DateTime @default(now())
  // Processing status: RECEIVED | LEAD_CREATED | DUPLICATE | OPTED_OUT | IGNORED
  status          String   @default("RECEIVED")
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([orgId, fromNumber])
  @@index([orgId, status])
  @@index([orgId, receivedAt])
}

/** Call and video meeting recordings */
model Recording {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // References — exactly one should be set
  callId          String?
  call            Call?    @relation(fields: [callId], references: [id])
  meetingId       String?
  meeting         Meeting? @relation(fields: [meetingId], references: [id])
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id])
  userId          String?
  // VIDEO | AUDIO | SCREEN_SHARE
  type            String   @default("AUDIO")
  // RECORDING | TRANSCRIBING | TRANSCRIBED | FAILED
  status          String   @default("RECORDING")
  fileName        String?
  fileUrl         String?
  fileSizeBytes   Int      @default(0)
  durationSeconds Int      @default(0)
  mimeType        String?
  // AI-generated fields populated after transcription
  transcript      String?
  summary         String?
  sentiment       String?  // POSITIVE | NEUTRAL | NEGATIVE
  actionItems     Json?    // string[]
  keyTopics       Json?    // string[]
  speakers        Json?    // [{ name, speakingTime, sentiment }]
  consentGiven    Boolean  @default(false)
  meetingNotes    MeetingNotes[]
  metadata        Json?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orgId, callId])
  @@index([orgId, meetingId])
  @@index([orgId, userId])
  @@index([orgId, status])
}

/** AI-generated meeting notes for calls and meetings */
model MeetingNotes {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  callId          String?
  call            Call?    @relation(fields: [callId], references: [id])
  meetingId       String?
  meeting         Meeting? @relation(fields: [meetingId], references: [id])
  recordingId     String?
  recording       Recording? @relation(fields: [recordingId], references: [id])
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id])
  userId          String?
  // AUTO_GENERATED | MANUAL | EDITED
  source          String   @default("AUTO_GENERATED")
  // The actual notes content
  title           String?
  notes           String   // markdown-formatted meeting notes
  summary         String?  // brief one-liner
  keyDecisions    Json?    // string[]
  actionItems     Json?    // [{ assignee, task, dueDate }]
  followUpItems   Json?    // string[]
  sentiment       String?  // POSITIVE | NEUTRAL | NEGATIVE
  attendees       Json?    // string[]
  durationMinutes Int?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orgId, callId])
  @@index([orgId, meetingId])
  @@index([orgId, leadId])
  @@index([orgId, userId])
}

// ────────────────────────────────────────────────────────────
// Phase 25: Bulk Calls, Video Rooms, SMS Outbound
// ────────────────────────────────────────────────────────────

/** Video call rooms for WebRTC meetings */
model VideoRoom {
  id              String   @id @default(cuid())
  roomId          String   @unique // public room identifier
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title           String
  hostId          String
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id])
  meetingId       String?
  meeting         Meeting? @relation(fields: [meetingId], references: [id])
  // WAITING | ACTIVE | RECORDING | ENDED
  status          String   @default("WAITING")
  maxParticipants Int      @default(10)
  recordingEnabled Boolean @default(true)
  passwordHash    String?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime @default(now())

  participants    VideoParticipant[]
  @@index([orgId, status])
  @@index([orgId, hostId])
}

/** Video call participants */
model VideoParticipant {
  id              String   @id @default(cuid())
  roomId          String
  room            VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId          String
  // HOST | PARTICIPANT
  role            String   @default("PARTICIPANT")
  isMuted         Boolean  @default(false)
  isVideoOff      Boolean  @default(false)
  // WebRTC signaling data
  sdp             String?
  sdpType         String?  // offer | answer
  iceCandidates   Json?    // string[]
  joinedAt        DateTime @default(now())
  leftAt          DateTime?

  @@index([roomId, userId])
}

/** Outbound SMS messages */
model SmsOutbound {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId          String?
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id])
  toNumber        String
  fromNumber      String?
  body            String
  // QUEUED | SENT | DELIVERED | FAILED | UNDELIVERABLE
  status          String   @default("QUEUED")
  providerMessageId String?
  error           String?
  cost            Float?
  sentAt          DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([orgId, leadId])
  @@index([orgId, status])
  @@index([orgId, createdAt])
}

