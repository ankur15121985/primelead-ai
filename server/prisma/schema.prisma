  title           String
  summary         String?
  // Structured sections: overview, business_model, pain_points, stakeholders, signals, recommendations
  sections        Json
  sources         Json?        // [{title, url, snippet}]
  confidence      Float        @default(0)
  // FACT | INFERENCE | AI_SUGGESTION — labels per section
  sectionLabels   Json?
  tokensUsed      Int          @default(0)
  costPaise       Int          @default(0)
  provider        String?
  model           String?
  createdAt       DateTime     @default(now())

  @@index([orgId, reportType])
  @@index([orgId, companyId])
  @@index([orgId, contactId])
  @@index([orgId, userId])
  @@index([orgId, createdAt])
}

model AiRecommendation {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId          String?
  // NEXT_BEST_LEAD | NEXT_BEST_ACTION | DEAL_RISK | CROSS_SELL | UPSELL | REACTIVATION
  type            String
  // lead | company | deal | contact
  entityType      String
  entityId        String
  title           String
  reasoning       String
  confidence      Float        @default(0)
  priority        String       @default("MEDIUM")
  // PENDING | ACCEPTED | DISMISSED | EXPIRED
  status          String       @default("PENDING")
  metadata        Json?
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orgId, type])
  @@index([orgId, entityType, entityId])
  @@index([orgId, userId, status])
  @@index([orgId, status, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 11: Forms Builder
// ────────────────────────────────────────────────────────────

model Form {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  // Embed code, webhook URL, success redirect
  slug            String
  fields          Json         // [{name, label, type, required, placeholder, options}]
  // Submission action: CREATE_LEAD | CREATE_CONTACT | WEBHOOK | EMAIL_NOTIFY
  submitAction    String       @default("CREATE_LEAD")
  submitConfig    Json?        // {webhookUrl, email, pipeline, stageId, assignTo}
  // Spam protection
  captchaEnabled  Boolean      @default(false)
  // UTM tracking
  utmTracking     Boolean      @default(true)
  // Styling
  theme           String?      // LIGHT | DARK | BRANDED
  customCss       String?
  // Stats
  totalSubmissions Int         @default(0)
  isActive        Boolean      @default(true)
  submissions    FormSubmission[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, slug])
  @@index([orgId, isActive])
}

model FormSubmission {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  formId          String
  form            Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  // Submission data: {fieldName: value}
  data            Json
  // Source tracking
  source          String?      // direct | social | ad | referral
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  // Visitor identification
  ipAddress       String?
  userAgent       String?
  referer         String?
  // Processing
  status          String       @default("NEW") // NEW | PROCESSED | DUPLICATE | SPAM | CONVERTED
  // Created entities
  leadId          String?
  contactId       String?
  processedAt     DateTime?
  metadata        Json?
  createdAt       DateTime     @default(now())

  @@index([orgId, formId])
  @@index([orgId, status])
  @@index([orgId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 11: Inbound Lead Routing
// ────────────────────────────────────────────────────────────

model InboundRule {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  // Conditions: {country, employeeRange, industry, source, leadScore, formId}
  conditions      Json
  // Actions: {assignTo, notifyUserIds, createTask, enrollSequence, addTag, changeStage, changePriority}
  actions         Json
  // Priority (lower = higher priority, evaluated in order)
  priority        Int          @default(100)
  isActive        Boolean      @default(true)
  runCount        Int          @default(0)
  lastRunAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orgId, isActive, priority])
}

// ────────────────────────────────────────────────────────────
// Phase 11: Website Visitor Tracking
// ────────────────────────────────────────────────────────────

model WebsiteVisit {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Visitor identification
  anonymousId     String       // first-party anonymous cookie ID
  // Company identification (where available from IP/fingerprint)
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Session info
  sessionId       String?
  pageUrl         String
  pageTitle       String?
  referrer        String?
  // UTM params
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  // Visitor info
  ipAddress       String?
  userAgent       String?
  country         String?
  city            String?
  // Scoring
  visitScore      Int          @default(0)
  isIdentified    Boolean      @default(false)
  // Matched lead/contact
  leadId          String?
  contactId       String?
  metadata        Json?
  visitedAt       DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@index([orgId, anonymousId])
  @@index([orgId, companyId])
  @@index([orgId, visitedAt])
  @@index([orgId, isIdentified])
}

// ────────────────────────────────────────────────────────────
// Phase 12: Meeting Intelligence
// ────────────────────────────────────────────────────────────

model MeetingPrep {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meetingId       String?
  contactId       String?
  companyId       String?
  // Pre-meeting research
  companyOverview String?
  contactProfile  String?
  previousInteractions Json?   // [{type, date, summary}]
