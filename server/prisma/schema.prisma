// PRIMELEAD AI — Prisma schema
// Local dev uses SQLite. For production, change the provider to "postgresql"
// and the DATABASE_URL — everything else in the schema is Postgres-compatible.
//
// Conventions:
//  * Every business entity carries `orgId` → Organization for hard multi-tenant isolation.
//  * Enums are modelled as String fields (SQLite doesn't support Prisma enums);
//    valid values are documented in comments and enforced by server-side zod validators.
//  * Money is stored as Int (paise). Postgres-compatible as-is — no swap needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────
// Core: Organization & Users
// ────────────────────────────────────────────────────────────

model Organization {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  businessType String? // RETAIL | REAL_ESTATE | EDUCATION | SERVICES | MANUFACTURING | HEALTHCARE | OTHER
  logoUrl      String?
  plan         String       @default("STARTER") // STARTER | GROWTH | BUSINESS
  status       String       @default("ACTIVE") // ACTIVE | SUSPENDED
  settings     OrgSetting[]
  users        User[]
  leads        Lead[]
  contacts     Contact[]
  activities   Activity[]
  tasks        Task[]
  pipelines    Pipeline[]
  quotations   Quotation[]
  invoices     Invoice[]
  creditNotes  CreditNote[]
  debitNotes   DebitNote[]
  conversations Conversation[]
  messages     Message[]
  waTemplates  WaTemplate[]
  integrations Integration[]
  integrationLogs IntegrationLog[]
  qrCodes      QrCode[]
  campaigns    Campaign[]
  notifications Notification[]
  aiConversations AiConversation[]
  aiUsage      AiUsage[]
  automationRules AutomationRule[]
  automationRuns AutomationRun[]
  auditLogs    AuditLog[]
  subscription Subscription?
  payments     Payment[]
  referrals    Referral[] @relation("ReferrerOrg")
  referredBy   Referral? @relation("ReferredOrg")
  roles        Role[]
  teams        Team[]
  companies    Company[]
  companyContacts CompanyContact[]
  savedSearches SavedSearch[]
  lists        List[]
  listMembers  ListMember[]
  dataProviders DataProvider[]
  dataProvenances DataProvenance[]
  icps         Icp[]
  personas     Persona[]
  scoringRules ScoringRule[]
  intentSignals IntentSignal[]
  companySignals CompanySignal[]
  sequences    Sequence[]
  sequenceEnrollments SequenceEnrollment[]
  sequenceEmailLogs SequenceEmailLog[]
  deliverabilityMetrics DeliverabilityMetric[]
  calls              Call[]
  meetings           Meeting[]
  conversationAnalyses ConversationAnalysis[]
  workflowNodes WorkflowNode[]
  workflowTemplates WorkflowTemplate[]
  aiResearchReports AiResearchReport[]
  aiRecommendations AiRecommendation[]
  forms              Form[]
  formSubmissions    FormSubmission[]
  inboundRules       InboundRule[]
  websiteVisits      WebsiteVisit[]
  meetingPreps       MeetingPrep[]
  analyticsSnapshots AnalyticsSnapshot[]
  consentRecords     ConsentRecord[]
  suppressionEntries SuppressionEntry[]
  retentionPolicies  RetentionPolicy[]
  exportJobs         ExportJob[]
  dataAccessRequests DataAccessRequest[]
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  savedReports       SavedReport[]
  territories        Territory[]
  accountOwnerships  AccountOwnership[]
  coachingInsights   CoachingInsight[]
  forecastEntries    ForecastEntry[]
  scheduledMessages  ScheduledMessage[]
  scheduledMessageLogs ScheduledMessageLog[]
  emailTemplates EmailTemplate[]
  scheduledReports ScheduledReport[]
  smsInbound     SmsInbound[]
  smsOutbound    SmsOutbound[]
  recordings      Recording[]
  meetingNotes    MeetingNotes[]
  videoRooms      VideoRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model User {
  id           String  @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String?
  passwordHash String
  role         String  @default("SALES") // OWNER | ADMIN | MANAGER | SALES | ACCOUNTANT | SUPPORT | VIEWER | custom role key
  title        String?
  teamId       String?
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  active       Boolean @default(true)
  emailVerifiedAt DateTime?
  avatarUrl    String?
  lastLoginAt  DateTime?
  lastAssignmentAt DateTime?
  failedLoginAttempts Int    @default(0)
  lockedUntil  DateTime?

  leads         Lead[]           @relation("LeadOwner")
  activities    Activity[]
  tasks         Task[]
  notifications Notification[]
  aiConversations AiConversation[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  referrals     Referral[]
  sessions      Session[]
  mfa           MfaSecret?
  recoveryCodes RecoveryCode[]
  loginHistory  LoginHistory[]
  ownedTerritories Territory[] @relation("TerritoryOwner")
  ownedAccounts   AccountOwnership[] @relation("AccountOwner")
  coOwnedAccounts AccountOwnership[] @relation("AccountCoOwner")
  coachingInsights CoachingInsight[]
  forecastEntries  ForecastEntry[] @relation("ForecastUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, email])
  @@index([orgId, role])
  @@index([orgId, teamId])
}

model OrgSetting {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key       String // e.g. leadSources, sourceAssignments, ai, whatsapp, notifications
  value     Json?
  updatedAt DateTime     @updatedAt

  @@unique([orgId, key])
}

// ────────────────────────────────────────────────────────────
// Leads, Contacts, Pipeline
// ────────────────────────────────────────────────────────────

model Lead {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  name           String
  phone          String?
  email          String?
  company        String?
  // WEBSITE | FACEBOOK | INSTAGRAM | GOOGLE_ADS | WHATSAPP | INDIAMART | JUSTDIAL |
  // TRADEINDIA | PROPERTY_PORTAL | SHOPIFY | ZAPIER | WEBHOOK | API | CSV | QR | MANUAL
  source         String       @default("MANUAL")
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id])
  campaignName   String?
  status         String       @default("NEW") // NEW | CONTACTED | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST
  stageId        String?
  stage          PipelineStage? @relation(fields: [stageId], references: [id])
  priority       String       @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  score          Int          @default(0)
  expectedValue  Int          @default(0) // paise
  notes          String?
  tags           Json? // string[]
  customFields   Json? // Record<string, string>
  lastContactedAt DateTime?
  nextFollowUpAt DateTime?
  expectedCloseAt DateTime?
  wonReason      String?
  lostReason     String?
  deletedAt      DateTime?

  activities Activity[]
  tasks      Task[]
  quotations Quotation[]
  invoices   Invoice[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]
  conversations Conversation[]
  contacts   Contact[]
  qrScans    QrScan[]
  meetings   Meeting[]
  smsInbound SmsInbound[]
  smsOutbound SmsOutbound[]
  recordings Recording[]
  meetingNotes MeetingNotes[]
  videoRooms VideoRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, phone])
  @@unique([orgId, email])
  @@index([orgId, status])
  @@index([orgId, stageId])
  @@index([orgId, ownerId])
  @@index([orgId, source])
  @@index([orgId, createdAt])
  @@index([orgId, nextFollowUpAt])
}

model Contact {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id])
  name      String
  phone     String?
  email     String?
  company   String?
  notes     String?
  tags      Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orgId, phone])
  @@index([orgId, email])
}

model Pipeline {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String       @default("Sales Pipeline")
  isDefault Boolean      @default(false)
  stages    PipelineStage[]
  createdAt DateTime     @default(now())

  @@index([orgId])
}

model PipelineStage {
  id         String    @id @default(cuid())
  pipelineId String
  pipeline   Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  orgId      String
  name       String
  order      Int       @default(0)
  color      String    @default("#64748b")
  isWon      Boolean   @default(false)
  isLost     Boolean   @default(false)
  // 0–100 — used for the weighted pipeline forecast.
  probability Int      @default(0)
  leads      Lead[]
  createdAt  DateTime  @default(now())

  @@index([orgId])
}

// ────────────────────────────────────────────────────────────
// Activities, Tasks / Follow-ups, Notifications
// ────────────────────────────────────────────────────────────

model Activity {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id])
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  // LEAD_CREATED | CALL | WHATSAPP | EMAIL | NOTE | MEETING | QUOTATION | INVOICE |
  // FOLLOW_UP | STATUS_CHANGE | ASSIGNMENT | SYSTEM
  type      String
  title     String
  body      String?
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([orgId, leadId])
  @@index([orgId, createdAt])
}

model Task {
  id               String       @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId           String?
  lead             Lead?        @relation(fields: [leadId], references: [id])
  userId           String
  user             User?        @relation(fields: [userId], references: [id])
  title            String
  kind             String       @default("FOLLOW_UP") // FOLLOW_UP | CALL | WHATSAPP | EMAIL | MEETING | TASK
  dueAt            DateTime
  status           String       @default("PENDING") // PENDING | DONE | MISSED | CANCELLED
  priority         String       @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  // Recurring follow-ups: when set, completing this task schedules the next
  // occurrence this many days later (same title/kind/notes/priority).
  repeatEveryDays  Int?
  notes            String?
  completedAt      DateTime?
  overdueNotifiedAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orgId, userId, status])
  @@index([orgId, dueAt])
  @@index([orgId, leadId])
}

model Notification {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User?        @relation(fields: [userId], references: [id])
  // FOLLOW_UP_OVERDUE | NEW_LEAD | LEAD_ASSIGNED | QUOTATION_ACCEPTED | INVOICE_OVERDUE | LEAD_STALE | SYSTEM
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([orgId, userId, readAt])
}

// ────────────────────────────────────────────────────────────
// Campaigns & QR lead capture
// ────────────────────────────────────────────────────────────

model Campaign {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  source      String       @default("QR") // QR | FACEBOOK | GOOGLE_ADS | OTHER
  description String?
  leads       Lead[]
  qrCodes     QrCode[]
  createdAt   DateTime     @default(now())

  @@index([orgId])
}

model QrCode {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign?    @relation(fields: [campaignId], references: [id])
  title       String
  description String?
  slug        String       @unique
  fields      Json? // ["name","phone","email","message"] — lead form fields
  scanCount   Int          @default(0)
  leadCount   Int          @default(0)
  enabled     Boolean      @default(true)
  scans       QrScan[]
  createdAt   DateTime     @default(now())
}

model QrScan {
  id        String   @id @default(cuid())
  qrId      String
  qr        QrCode   @relation(fields: [qrId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  ip        String?
  createdAt DateTime @default(now())

  @@index([qrId])
  @@index([leadId])
}

// ────────────────────────────────────────────────────────────
// Quotations & Invoices (GST ready)
// ────────────────────────────────────────────────────────────

model Quotation {
  id          String          @id @default(cuid())
  orgId       String
  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number      String
  leadId      String?
  lead        Lead?           @relation(fields: [leadId], references: [id])
  customerName String
  company     String?
  address     String?
  gstin       String?
  phone       String?
  email       String?
  items       QuotationItem[]
  discount    Int             @default(0) // paise
  gstSummary  Json? // { cgst, sgst, igst } — paise
  subtotal    Int             @default(0) // paise
  total       Int             @default(0) // paise
  terms       String?
  validityDays Int            @default(15)
  status      String          @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED | CONVERTED
  invoiceId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description  String
  quantity     Float     @default(1)
  rate         Int       @default(0) // paise
  discountPct  Float     @default(0)
  taxPct       Float     @default(0) // e.g. 18
  cgst         Int       @default(0) // paise
  sgst         Int       @default(0) // paise
  igst         Int       @default(0) // paise
  amount       Int       @default(0) // paise
  createdAt    DateTime  @default(now())
}

model Invoice {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number         String
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  quotationId    String?
  customerName   String
  company        String?
  billingAddress String?
  gstin          String?
  hsnSac         String?
  creditNotes    CreditNote[]
  items          InvoiceItem[]
  discount       Int          @default(0) // paise
  gstSummary     Json? // { cgst, sgst, igst } — paise
  subtotal       Int          @default(0) // paise
  total          Int          @default(0) // paise
  paidAmount     Int          @default(0) // paise
  status         String       @default("DRAFT") // DRAFT | SENT | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  dueDate        DateTime?
  terms          String?
  metadata       Json?        // e-invoice IRN, e-way bill EWB, provider details
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hsnSac    String?
  quantity  Float   @default(1)
  rate      Int     @default(0) // paise
  discountPct Float @default(0)
  taxPct    Float   @default(0)
  cgst      Int     @default(0) // paise
  sgst      Int     @default(0) // paise
  igst      Int     @default(0) // paise
  amount    Int     @default(0) // paise
  createdAt DateTime @default(now())
}

// Credit note — issued against an invoice for returns, corrections or
// discounts given after invoicing (reduces the amount owed / collected).
model CreditNote {
  id             String           @id @default(cuid())
  orgId          String
  org            Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number         String
  invoiceId      String?
  invoice        Invoice?         @relation(fields: [invoiceId], references: [id])
  leadId         String?
  lead           Lead?            @relation(fields: [leadId], references: [id])
  customerName   String
  company        String?
  gstin          String?
  reason         String? // why the note was issued
  items          CreditNoteItem[]
  discount       Int              @default(0) // paise
  gstSummary     Json? // { cgst, sgst, igst } — paise
  subtotal       Int              @default(0) // paise
  total          Int              @default(0) // paise
  status         String           @default("DRAFT") // DRAFT | ISSUED | CANCELLED
  issuedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  description  String
  hsnSac       String?
  quantity     Float      @default(1)
  rate         Int        @default(0) // paise
  discountPct  Float      @default(0)
  taxPct       Float      @default(0)
  cgst         Int        @default(0) // paise
  sgst         Int        @default(0) // paise
  igst         Int        @default(0) // paise
  amount       Int        @default(0) // paise
  createdAt    DateTime   @default(now())
}

// Debit note — issued to a customer for additional charges, short payments
// or corrections that increase the amount owed.
model DebitNote {
  id           String          @id @default(cuid())
  orgId        String
  org          Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number       String
  leadId       String?
  lead         Lead?           @relation(fields: [leadId], references: [id])
  customerName String
  company      String?
  gstin        String?
  reason       String?
  items        DebitNoteItem[]
  discount     Int             @default(0) // paise
  gstSummary   Json? // { cgst, sgst, igst } — paise
  subtotal     Int             @default(0) // paise
  total        Int             @default(0) // paise
  status       String          @default("DRAFT") // DRAFT | ISSUED | CANCELLED
  issuedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
}

model DebitNoteItem {
  id          String    @id @default(cuid())
  debitNoteId String
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  description String
  hsnSac      String?
  quantity    Float     @default(1)
  rate        Int       @default(0) // paise
  discountPct Float     @default(0)
  taxPct      Float     @default(0)
  cgst        Int       @default(0) // paise
  sgst        Int       @default(0) // paise
  igst        Int       @default(0) // paise
  amount      Int       @default(0) // paise
  createdAt   DateTime  @default(now())
}

// ────────────────────────────────────────────────────────────
// WhatsApp conversations (shared team inbox)
// ────────────────────────────────────────────────────────────

model Conversation {
  id               String       @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId           String?
  lead             Lead?        @relation(fields: [leadId], references: [id])
  contactId        String?
  // Customer's WhatsApp number/ID (E.164, digits only) — unique per org.
  waId             String
  customerName     String
  channel          String       @default("WHATSAPP") // WHATSAPP | (future: EMAIL | SMS …)
  status           String       @default("OPEN") // OPEN | CLOSED
  assigneeId       String?
  assignee         User?        @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  labels           Json? // string[]
  lastMessageAt    DateTime?
  lastMessagePreview String?
  unreadCount      Int          @default(0)
  messages         Message[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([orgId, waId])
  @@index([orgId, status])
  @@index([orgId, assigneeId])
  @@index([orgId, updatedAt])
}

model Message {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction       String       @default("INBOUND") // INBOUND | OUTBOUND
  channel         String       @default("WHATSAPP")
  type            String       @default("TEXT") // TEXT | MEDIA | TEMPLATE
  body            String?
  mediaUrl        String?
  mediaType       String? // image | video | document | audio
  mediaCaption    String?
  // Provider message id — the idempotency key for inbound/status webhooks.
  waMessageId     String?      @unique
  waTemplateName  String?
  status          String       @default("QUEUED") // QUEUED | SENT | DELIVERED | READ | FAILED
  error           String?
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  metadata        Json?
  createdAt       DateTime     @default(now())

  @@index([orgId, conversationId])
  @@index([orgId, createdAt])
}

model WaTemplate {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String // provider template name, e.g. follow_up_offer
  category    String       @default("UTILITY") // UTILITY | MARKETING | AUTHENTICATION
  language    String       @default("en")
  body        String // supports {{1}}, {{2}} placeholders
  status      String       @default("ACTIVE") // ACTIVE | PAUSED
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orgId, name])
}

// ────────────────────────────────────────────────────────────
// Integrations & Webhooks
// ────────────────────────────────────────────────────────────

model Integration {
  id             String            @id @default(cuid())
  orgId          String
  org            Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // FACEBOOK | INSTAGRAM | GOOGLE_ADS | WHATSAPP | INDIAMART | JUSTDIAL |
  // TRADEINDIA | SHOPIFY | ZAPIER | WEBHOOK | API | CUSTOM
  source         String
  name           String
  config         Json? // credentials kept server-side only (encrypted in production)
  webhookSecret  String?
  webhookUrl     String?
  enabled        Boolean           @default(false)
  status         String            @default("DISCONNECTED") // DISCONNECTED | CONNECTED | ERROR
  lastSyncAt     DateTime?
  errorCount     Int               @default(0)
  lastError      String?
  logs           IntegrationLog[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([orgId, source])
}

/** Every inbound attempt on an integration — success, duplicate, or failure. */
model IntegrationLog {
  id            String      @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  source        String // INDIAMART | FACEBOOK | …
  status        String // SUCCESS | DUPLICATE | INVALID | FAILED
  leadId        String?
  message       String?
  // Provider event id (leadgen_id / query id) — a natural replay key.
  externalId    String?
  error         String?
  createdAt     DateTime    @default(now())

  @@index([orgId, source, createdAt])
}

// ────────────────────────────────────────────────────────────
// AI assistant (conversational, org-scoped)
// ────────────────────────────────────────────────────────────

model AiConversation {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User?        @relation(fields: [userId], references: [id])
  topic     String?
  messages  AiMessage[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orgId, userId])
}

model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String
  createdAt      DateTime      @default(now())
}

/**
 * AI usage ledger (spec §23) — every provider call is recorded so orgs can
 * see spend and budgets can be enforced. Tokens + estimated cost in paise.
 */
model AiUsage {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId            String?
  provider          String       @default("openai-compatible")
  model             String?
  category          String // FOLLOW_UP | CHAT | LEAD_SUMMARY | LEAD_SCORE | NEXT_ACTION | OTHER
  promptTokens      Int          @default(0)
  completionTokens  Int          @default(0)
  totalTokens       Int          @default(0)
  costEstimatePaise Int          @default(0)
  latencyMs         Int?         @default(0)
  createdAt         DateTime     @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, category])
}

// ────────────────────────────────────────────────────────────
// Automation engine (spec §31) — rules as data, not hard-coded logic
// ────────────────────────────────────────────────────────────

model AutomationRule {
  id            String           @id @default(cuid())
  orgId         String
  org           Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  // LEAD_CREATED | LEAD_ASSIGNED | STAGE_CHANGED | FOLLOW_UP_OVERDUE |
  // INVOICE_CREATED | PAYMENT_RECEIVED | QUOTATION_CREATED
  trigger       String
  triggerConfig Json? // conditions, e.g. { source, stageId, minValue }
  actions       Json // [{ type, config }] — evaluated server-side, capped
  enabled       Boolean          @default(true)
  runCount      Int              @default(0)
  lastRunAt     DateTime?
  runs          AutomationRun[]
  workflowNodes WorkflowNode[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([orgId, trigger, enabled])
}

model AutomationRun {
  id         String          @id @default(cuid())
  orgId      String
  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ruleId     String?
  rule       AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  trigger    String
  entityType String // LEAD | TASK | INVOICE | PAYMENT | QUOTATION
  entityId   String?
  status     String          @default("SUCCESS") // SUCCESS | SKIPPED | PARTIAL | FAILED
  result     Json?
  createdAt  DateTime        @default(now())

  @@index([orgId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Security: audit, password reset, email verification
// ────────────────────────────────────────────────────────────

model AuditLog {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime     @default(now())

  @@index([orgId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Referral / Affiliate System
// ────────────────────────────────────────────────────────────

model Referral {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation("ReferrerOrg", fields: [orgId], references: [id], onDelete: Cascade)
  referrerUserId  String
  referrerUser    User?        @relation(fields: [referrerUserId], references: [id])
  referralCode    String       @unique
  referredOrgId   String?      @unique
  referredOrg     Organization? @relation("ReferredOrg", fields: [referredOrgId], references: [id])
  status          String       @default("PENDING") // PENDING | CONVERTED | PAID
  commissionPct   Float        @default(10) // percentage commission
  commissionAmount Int         @default(0) // paise
  notes           String?
  payouts         ReferralPayout[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orgId, referrerUserId])
  @@index([referralCode])
}

model ReferralPayout {
  id          String   @id @default(cuid())
  referralId  String
  referral    Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  amount      Int      // paise
  currency    String   @default("INR")
  status      String   @default("PENDING") // PENDING | PAID | FAILED
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([referralId])
}

model ResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ────────────────────────────────────────────────────────────
// Billing (provider-agnostic — Razorpay / Stripe later)
// ────────────────────────────────────────────────────────────

model Plan {
  id           String  @id @default(cuid())
  slug         String  @unique // starter | growth | business | custom
  name         String
  priceMonthly Int // paise
  priceYearly  Int // paise
  features     Json?
  // Usage limits — config-driven, 0 = unlimited. Never hard-code these in code.
  userLimit    Int     @default(0) // 0 = unlimited
  leadLimit    Int     @default(0) // 0 = unlimited
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id                String       @id @default(cuid())
  orgId             String       @unique
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planId            String?
  plan              Plan?        @relation(fields: [planId], references: [id])
  status            String       @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  period            String       @default("MONTHLY") // MONTHLY | YEARLY
  startsAt          DateTime     @default(now())
  endsAt            DateTime?
  cancelAtPeriodEnd Boolean      @default(false) // cancel at the next renewal, keep service until then
  trialEndsAt       DateTime?
  provider          String? // razorpay | stripe | cashfree | demo
  providerSubId     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([orgId])
}

model Payment {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  amount            Int // paise
  currency          String       @default("INR")
  // PENDING | SUCCEEDED | FAILED | PARTIALLY_REFUNDED | REFUNDED
  status            String       @default("PENDING")
  provider          String?
  providerOrderId   String? // provider checkout/order id (for matching webhooks)
  providerPaymentId String? // provider payment/charge id
  refundedAmount    Int          @default(0) // paise
  paidAt            DateTime?
  createdAt         DateTime     @default(now())

  @@index([orgId])
  @@index([provider, providerOrderId])
}

// Inbound payment-provider webhooks. The unique (provider, eventId) is the
// idempotency key — the same provider event is never processed twice.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String // razorpay | stripe | cashfree | demo
  eventId     String
  type        String // payment.captured | checkout.session.completed | …
  orgId       String?
  status      String   @default("RECEIVED") // RECEIVED | PROCESSED | FAILED
  payload     Json?
  error       String?
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([orgId])
}

// ────────────────────────────────────────────────────────────
// Auth hardening: sessions, login history, MFA
// ────────────────────────────────────────────────────────────

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  ip         String?
  userAgent  String?
  deviceName String?
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  orgId     String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  reason    String? // OK | BAD_PASSWORD | UNKNOWN_USER | LOCKED | ORG_SUSPENDED | MFA_OK | RECOVERY_OK
  newDevice Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model MfaSecret {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret    String // TOTP base32 secret (server-side only)
  createdAt DateTime @default(now())
}

model RecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ────────────────────────────────────────────────────────────
// RBAC: configurable roles & permissions (per-org)
// ────────────────────────────────────────────────────────────

model Role {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key         String // OWNER | ADMIN | MANAGER | SALES | ACCOUNTANT | SUPPORT | VIEWER | custom
  name        String
  description String?
  isSystem    Boolean      @default(false)
  permissions Json? // string[] — granular permission keys
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orgId, key])
  @@index([orgId])
}

// ────────────────────────────────────────────────────────────
// Teams (Org → Team → User)
// ────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

// ────────────────────────────────────────────────────────────
// Phase 1: B2B Company Database
// ────────────────────────────────────────────────────────────

model Company {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  legalName      String?
  website        String?
  domain         String?
  industry       String?      // TECHNOLOGY | HEALTHCARE | FINANCE | MANUFACTURING | etc.
  subIndustry    String?
  description    String?
  foundedYear    Int?
  employeeCount  Int?         // estimated headcount
  employeeRange  String?      // 1-10 | 11-50 | 51-200 | 201-500 | 501-1000 | 1001-5000 | 5001-10000 | 10001+
  employeeGrowth Float?       // % YoY growth
  revenueRange   String?      // 0-1M | 1M-10M | 10M-50M | 50M-100M | 100M-500M | 500M-1B | 1B+
  fundingTotal   Int?         // total funding in paise
  fundingRounds  Json?        // [{ round, amount, date, investor }]
  headquarters   String?
  country        String?
  state          String?
  city           String?
  postalCode     String?
  technologies   Json?        // string[] — tech stack
  socialProfiles Json?        // { linkedin, twitter, facebook, crunchbase }
  phone          String?
  emailDomains   Json?        // string[]
  naicsCode      String?
  sicCode        String?
  companyType    String?      // PRIVATE | PUBLIC | NON_PROFIT | GOVERNMENT | PARTNERSHIP
  ownership      String?
  parentCompanyId String?
  subsidiaries   Json?        // string[]
  status         String       @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED
  score          Int          @default(0)         // 0-100 account score
  tags           Json?        // string[]
  customFields   Json?        // Record<string, string>
  deletedAt      DateTime?

  contacts       CompanyContact[]
  websiteVisits  WebsiteVisit[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([orgId, domain])
  @@index([orgId, industry])
  @@index([orgId, country])
  @@index([orgId, employeeCount])
  @@index([orgId, status])
  @@index([orgId, createdAt])
}

model CompanyContact {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String?
  fullName    String?
  jobTitle    String?
  department  String?      // ENGINEERING | SALES | MARKETING | FINANCE | HR | LEGAL | OPERATIONS | EXECUTIVE
  seniority   String?      // C_LEVEL | VP | DIRECTOR | MANAGER | SENIOR | STAFF | INTERN
  email       String?
  emailStatus String?      // VALID | INVALID | RISKY | UNKNOWN | CATCH_ALL | DISPOSABLE
  phone       String?
  mobile      String?
  location    String?
  linkedinUrl String?
  otherProfiles Json?      // { twitter, github, website }
  yearsAtCompany Int?
  employmentHistory Json?  // [{ company, title, startDate, endDate }]
  education   Json?        // [{ school, degree, field, startYear, endYear }]
  skills      Json?        // string[]
  notes       String?
  tags        Json?        // string[]
  score       Int          @default(0) // 0-100 contact score
  status      String       @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED
  deletedAt   DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orgId, email])
  @@index([orgId, companyId])
  @@index([orgId, seniority])
  @@index([orgId, department])
  @@index([orgId, status])
  @@index([orgId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 1: Data Provider Abstraction
// ────────────────────────────────────────────────────────────

model DataProvider {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String       // e.g. "clearbit", "apollo", "csv-import", "website"
  type        String       // COMPANY_SEARCH | CONTACT_SEARCH | ENRICHMENT | VERIFICATION | INTENT
  baseUrl     String?
  config      Json?        // provider-specific config (API key kept server-side only)
  enabled     Boolean      @default(true)
  priority    Int          @default(0) // higher = tried first in waterfall
  costPerQuery Int         @default(0) // paise per query
  status      String       @default("ACTIVE") // ACTIVE | ERROR | DISABLED
  lastError   String?
  lastUsedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  dataProvenances DataProvenance[]

  @@unique([orgId, name])
  @@index([orgId, type])
}

// ────────────────────────────────────────────────────────────
// Phase 1: Data Provenance Tracking
// ────────────────────────────────────────────────────────────

model DataProvenance {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  providerId    String?
  provider      DataProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  // COMPANY | CONTACT | LEAD
  entityType    String
  entityId      String
  // e.g. "email", "phone", "linkedinUrl", "employeeCount", "revenueRange"
  fieldName     String
  value         String?
  source        String       // provider name or "user" | "csv" | "website" | "manual"
  sourceId      String?      // external record ID from the provider
  confidence    Float?       // 0-1, provider-reported confidence
  verifiedAt    DateTime?
  collectedAt   DateTime     @default(now())
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([orgId, entityType, entityId])
  @@index([orgId, fieldName])
  @@index([orgId, providerId])
  @@index([orgId, collectedAt])
}

// ────────────────────────────────────────────────────────────
// Phase 2: Saved Searches
// ────────────────────────────────────────────────────────────

model SavedSearch {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId      String?
  name        String
  description String?
  // "companies" | "contacts" | "leads"
  entityType  String       @default("companies")
  filters     Json         // { industry: [...], employeeRange: [...], ... }
  resultCount Int          @default(0)
  isShared    Boolean      @default(false)
  alertEnabled Boolean     @default(false)
  lastAlertAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId, userId])
  @@index([orgId, entityType])
}

// ────────────────────────────────────────────────────────────
// Phase 2: Lists (static + dynamic)
// ────────────────────────────────────────────────────────────

model List {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        String       @default("STATIC") // STATIC | DYNAMIC
  entityType  String       @default("companies") // companies | contacts | leads
  // For dynamic lists: the filter criteria
  filters     Json?
  memberCount Int          @default(0)
  tags        Json?        // string[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members     ListMember[]

  @@unique([orgId, name])
  @@index([orgId, entityType])
}

model ListMember {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  listId      String
  list        List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  // COMPANY | CONTACT | LEAD
  entityType  String
  entityId    String
  addedAt     DateTime     @default(now())

  @@unique([listId, entityType, entityId])
  @@index([orgId, listId])
  @@index([orgId, entityType, entityId])
}

// ────────────────────────────────────────────────────────────
// Phase 3: ICP (Ideal Customer Profile) Builder
// ────────────────────────────────────────────────────────────

model Icp {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  // Company criteria
  industries      Json?        // string[]
  subIndustries   Json?        // string[]
  employeeRanges  Json?        // string[]
  revenueRanges   Json?        // string[]
  countries       Json?        // string[]
  states          Json?        // string[]
  cities          Json?        // string[]
  companyTypes    Json?        // string[]
  technologies    Json?        // string[]
  fundingRanges   Json?        // string[]
  foundedAfter    Int?
  foundedBefore   Int?
  // Contact criteria
  jobTitles       Json?        // string[]
  seniorities     Json?        // string[]
  departments     Json?        // string[]
  // Behavioral criteria
  buyingSignals   Json?        // string[]
  painPoints      Json?        // string[]
  keywords        Json?        // string[]
  // AI-generated
  aiSummary       String?
  aiRecommendations Json?      // [{ field, reason, confidence }]
  matchScore      Int          @default(0) // 0-100, how well this ICP matches existing data
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, name])
  @@index([orgId, isActive])
}

// ────────────────────────────────────────────────────────────
// Phase 3: Persona Builder
// ────────────────────────────────────────────────────────────

model Persona {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  // Target role criteria
  jobTitles       Json?        // string[]
  seniorities     Json?        // string[]
  departments     Json?        // string[]
  // Context
  industries      Json?        // string[]
  companySizes    Json?        // string[] — employee ranges
  locations       Json?        // string[]
  // Messaging
  painPoints      Json?        // string[]
  goals           Json?        // string[]
  objections      Json?        // string[]
  messagingTips   Json?        // string[]
  valuePropositions Json?      // string[]
  // Engagement
  preferredChannels Json?      // string[] — email, phone, linkedin, etc.
  bestApproach    String?
  // Stats
  contactCount    Int          @default(0) // contacts matching this persona
  avgScore        Float        @default(0) // average score of matching contacts
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, name])
  @@index([orgId, isActive])
}

// ────────────────────────────────────────────────────────────
// Phase 5: Configurable Lead Scoring Rules
// ────────────────────────────────────────────────────────────

model ScoringRule {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  field       String
  operator    String
  value       Json?
  points      Int          @default(0)
  enabled     Boolean      @default(true)
  priority    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orgId, name])
  @@index([orgId, enabled])
}

// ────────────────────────────────────────────────────────────
// Phase 5: Buying Intent Signals
// ────────────────────────────────────────────────────────────

model IntentSignal {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyId   String?
  contactId   String?
  type        String
  topic       String?
  source      String
  confidence  Float        @default(0)
  metadata    Json?
  lastSeenAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([orgId, companyId])
  @@index([orgId, contactId])
  @@index([orgId, type])
  @@index([orgId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 5: Company Signals
// ────────────────────────────────────────────────────────────

model CompanySignal {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyId   String
  type        String
  title       String
  description String?
  source      String
  confidence  Float        @default(0)
  evidence    Json?
  metadata    Json?
  detectedAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([orgId, companyId])
  @@index([orgId, type])
  @@index([orgId, detectedAt])
}

// ────────────────────────────────────────────────────────────
// Phase 6: Email Sequences
// ────────────────────────────────────────────────────────────

model Sequence {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  status          String       @default("DRAFT")
  steps           SequenceStep[]
  enrollments     SequenceEnrollment[]
  totalEnrolled   Int          @default(0)
  totalCompleted  Int          @default(0)
  totalReplied    Int          @default(0)
  totalBounced    Int          @default(0)
  totalUnsubscribed Int        @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, name])
  @@index([orgId, status])
}

model SequenceStep {
  id          String       @id @default(cuid())
  sequenceId  String
  sequence    Sequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  orgId       String
  order       Int
  type        String
  subject     String?
  body        String?
  templateId  String?
  waitDays    Int?
  waitHours   Int?
  conditionType String?
  conditionValue String?
  aiPrompt    String?
  aiAction    String?
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@index([sequenceId, order])
}

model SequenceEnrollment {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sequenceId      String
  sequence        Sequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId       String?
  leadId          String?
