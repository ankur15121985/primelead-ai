// ────────────────────────────────────────────────────────────
// Phase 7: Calling / Dialer
// ────────────────────────────────────────────────────────────

model Call {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId          String?
  contactId       String?
  userId          String?
  // OUTBOUND | INBOUND
  direction       String       @default("OUTBOUND")
  // CONNECTED | NO_ANSWER | BUSY | VOICEMAIL | FAILED | CANCELLED
  status          String
  fromNumber      String?
  toNumber        String?
  durationSeconds Int          @default(0)
  // DISPOSITION codes
  disposition     String?      // CONNECTED | LEFT_VOICEMAIL | CALLBACK | NOT_INTERESTED | INTERESTED | MEETING_BOOKED | DO_NOT_CALL | WRONG_NUMBER
  notes           String?
  recordingUrl    String?
  recordingConsent Boolean     @default(false)
  // AI-generated
  transcript      String?
  summary         String?
  sentiment       String?      // POSITIVE | NEUTRAL | NEGATIVE
  actionItems     Json?        // string[]
  metadata        Json?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime     @default(now())

  recordings      Recording[]
  meetingNotes    MeetingNotes[]
  @@index([orgId, leadId])
  @@index([orgId, userId])
  @@index([orgId, status])
  @@index([orgId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 7: Meeting Scheduler
// ────────────────────────────────────────────────────────────

model Meeting {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            Lead?        @relation(fields: [leadId], references: [id])
  contactId       String?
  hostId          String?
  title           String
  description     String?
  // SCHEDULED | COMPLETED | CANCELLED | NO_SHOW
  status          String       @default("SCHEDULEED")
  meetingType     String       @default("1_1") // 1_1 | ROUND_ROBIN | TEAM | MULTI_HOST
  startAt         DateTime
  endAt           DateTime
  durationMinutes Int          @default(30)
  timezone        String       @default("Asia/Kolkata")
  // Calendar integration
  calendarEventId String?
  calendarProvider String?     // google | microsoft
  meetingUrl      String?
  // Pre/post meeting
  prepNotes       String?
  summary         String?
  actionItems     Json?        // string[]
  followUpTaskId  String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  recordings      Recording[]
  meetingNotes    MeetingNotes[]
  videoRooms      VideoRoom[]
  @@index([orgId, hostId])
  @@index([orgId, leadId])
  @@index([orgId, status])
  @@index([orgId, startAt])
}

// ────────────────────────────────────────────────────────────
// Phase 8: Conversation Intelligence
// ────────────────────────────────────────────────────────────

model ConversationAnalysis {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  callId          String?
  meetingId       String?
  contactId       String?
