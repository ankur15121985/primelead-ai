  sentiment       String?      // POSITIVE | NEUTRAL | NEGATIVE
  // AI generation metadata
  tokensUsed      Int          @default(0)
  provider        String?
  model           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orgId, meetingId])
  @@index([orgId, contactId])
  @@index([orgId, companyId])
}

// ────────────────────────────────────────────────────────────
// Phase 12: Analytics Snapshots
// ────────────────────────────────────────────────────────────

model AnalyticsSnapshot {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // DAILY | WEEKLY | MONTHLY
  period          String       @default("DAILY")
  date            DateTime
  // Metrics
  newLeads        Int          @default(0)
  qualifiedLeads  Int          @default(0)
  dealsCreated    Int          @default(0)
  dealsWon        Int          @default(0)
  dealsLost       Int          @default(0)
  revenueWon      Int          @default(0) // in paise
  revenuePipeline Int          @default(0) // in paise
  emailsSent      Int          @default(0)
  emailsOpened    Int          @default(0)
  emailsReplied   Int          @default(0)
  emailsBounced   Int          @default(0)
  callsMade       Int          @default(0)
  callsConnected  Int          @default(0)
  meetingsBooked  Int          @default(0)
  meetingsHeld    Int          @default(0)
  tasksCompleted  Int          @default(0)
  sequencesEnrolled Int        @default(0)
  websiteVisits   Int          @default(0)
  formSubmissions Int          @default(0)
  // Per-rep breakdown (JSON)
  byUser          Json?        // [{userId, name, leads, deals, revenue}]
  // Per-source breakdown
  bySource        Json?        // [{source, leads, deals, revenue}]
  metadata        Json?
  createdAt       DateTime     @default(now())

